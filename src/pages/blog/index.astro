---
import { getCollection } from 'astro:content';
import Entry from '../../components/Entry.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Base from '../../layouts/Base.astro';
import { sortPosts } from '../../lib/posts';

const posts = sortPosts(await getCollection('blog'));
---

<Base title="Writing" description="Notes on Go, distributed systems and LLM agents.">
	<h1>Writing</h1>
	{
		posts.length === 0 ? (
			<p class="dim">Nothing published yet.</p>
		) : (
			posts.map((post) => (
				<Entry title={post.data.title} href={`/blog/${post.id}/`} blurb={post.data.description}>
					<FormattedDate slot="meta" date={post.data.pubDate} />
				</Entry>
			))
		)
	}
</Base>
