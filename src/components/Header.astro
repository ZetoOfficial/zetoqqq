---
import type { NavItem } from '../lib/nav';
import { profile } from '../data/profile';
import HeaderLink from './HeaderLink.astro';

interface Props {
	nav: NavItem[];
}

const { nav } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<header class="column">
	{
		isHome ? (
			<h1 class="name">
				<a href="/">{profile.name}</a>
			</h1>
		) : (
			<p class="name">
				<a href="/">{profile.name}</a>
			</p>
		)
	}
	<p class="role dim">{profile.role} &mdash; {profile.location}</p>
	<nav aria-label="Primary">
		{nav.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		<slot name="toggle" />
	</nav>
</header>

<style>
	header {
		padding-top: var(--sp-7);
	}
	.name {
		margin: 0;
		font-size: var(--fs-xl);
		/* Pinned because Header renders the name as <h1> on / and <p> elsewhere,
		   and those inherit different line-heights from global.css. Without this
		   the whole header shifts between pages. */
		line-height: var(--lh-tight);
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.name a {
		text-decoration: none;
	}
	.role {
		margin: 0 0 var(--sp-5);
	}
	nav {
		display: flex;
		align-items: center;
		gap: var(--sp-4);
		padding: var(--sp-2) 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		font-size: var(--fs-sm);
	}
</style>
