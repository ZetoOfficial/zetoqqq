---
import type { NavItem } from '../lib/nav';
import { profile } from '../data/profile';
import HeaderLink from './HeaderLink.astro';

interface Props {
	nav: NavItem[];
}

const { nav } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<header class="column">
	{
		isHome ? (
			<h1 class="name">
				<a href="/">{profile.name}</a>
			</h1>
		) : (
			<p class="name">
				<a href="/">{profile.name}</a>
			</p>
		)
	}
	<p class="role dim">{profile.role} &mdash; {profile.location}</p>
	<nav aria-label="Primary">
		<span class="site">
			{
				nav.map((item) =>
					item.pending ? (
						<span class="pending" data-hint="soon...">
							{item.label}
							{/* The hover hint is unreachable without a pointer, so the
							    same fact is stated for assistive technology. */}
							<span class="sr-only"> &mdash; coming soon</span>
						</span>
					) : (
						<HeaderLink href={item.href}>{item.label}</HeaderLink>
					),
				)
			}
		</span>
		<span class="elsewhere">
			{
				profile.links.map((link) => (
					<a href={link.href} rel="me noopener">
						{link.label}
					</a>
				))
			}
		</span>
		<slot name="toggle" />
	</nav>
</header>

<style>
	header {
		padding-top: var(--sp-7);
	}
	.name {
		margin: 0;
		font-size: var(--fs-xl);
		/* Pinned because Header renders the name as <h1> on / and <p> elsewhere,
		   and those inherit different line-heights from global.css. Without this
		   the whole header shifts between pages. */
		line-height: var(--lh-tight);
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.name a {
		text-decoration: none;
	}
	.role {
		margin: 0 0 var(--sp-5);
	}
	nav {
		display: flex;
		align-items: center;
		gap: var(--sp-4);
		padding: var(--sp-2) 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		font-size: var(--fs-sm);
	}
	.site,
	.elsewhere {
		display: flex;
		align-items: center;
		gap: var(--sp-4);
	}
	/* Pushes the elsewhere group and the theme toggle to the right edge. */
	.elsewhere {
		margin-left: auto;
	}
	.pending {
		position: relative;
		color: var(--ink-dim);
		cursor: default;
	}
	.pending:hover::after {
		content: attr(data-hint);
		position: absolute;
		top: 100%;
		left: 0;
		z-index: 1;
		margin-top: var(--sp-1);
		padding: var(--sp-1) var(--sp-2);
		background: var(--bg-subtle);
		border: 1px solid var(--rule);
		color: var(--ink-dim);
		font-size: var(--fs-xs);
		white-space: nowrap;
	}
	.elsewhere a {
		color: var(--ink-dim);
		text-decoration: none;
	}
	.elsewhere a:hover {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	/* The column is narrow; below it the two groups stack rather than collide. */
	@media (max-width: 34rem) {
		nav {
			flex-wrap: wrap;
			row-gap: var(--sp-2);
		}
		.elsewhere {
			margin-left: 0;
		}
	}
</style>
